<%- include("partials/header") %>

<h2>All Students</h2>

<a href="/add-student">Add New Student</a>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Marks</th>
        <th>Grade</th>
        <th>Status</th>
        <th>Details</th>
    </tr>

    <% students.forEach(student => { %>
        <tr>
            <td><%= student.id %></td>
            <td><%= student.name %></td>
            <td><%= student.marks %></td>
            <td><%= student.grade %></td>

            <!-- Conditional -->
            <td>
                <% if(student.marks >= 40) { %>
                    Pass ✅
                <% } else { %>
                    Fail ❌
                <% } %>
            </td>

            <td>
                <a href="/students/<%= student.id %>">View</a>
            </td>
        </tr>
    <% }) %>

</table>

<%- include("partials/footer") %>
